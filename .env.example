# The default command runs the free offline demo. --live enables model calls.
# Set the model once here; all agents use it for new and resumed live quizzes.
# Format: provider:model-id. For OpenRouter: openrouter:publisher/model:free
# Choose an available model with tool support. Keep :free for a free endpoint.
QUIZPILOT_MODEL=
OPENROUTER_API_KEY=

# --- Web app only; the CLI ignores everything below. ---

# Postgres connection string. Required when deployed, because a serverless
# filesystem does not persist and a SQLite session file would disappear
# between requests. Left empty locally, the web app shares the CLI's
# .quizpilot/sessions.sqlite3 file instead.
DATABASE_URL=
